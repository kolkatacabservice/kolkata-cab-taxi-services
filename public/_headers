# Cloudflare Pages _headers file
# These headers are applied by Cloudflare's edge — replaces next.config.ts headers()
# which are ignored with next-on-pages edge runtime.

# ── Security + SEO headers on ALL pages ─────────────────────────────────────
/*
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://www.analytics.google.com https://www.googletagmanager.com https://wa.me; frame-src https://www.google.com https://maps.google.com https://maps.googleapis.com https://www.googletagmanager.com;
  Content-Language: en-IN

# ── Immutable cache for static assets (hash in filename) ─────────────────────
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# ── Image assets ─────────────────────────────────────────────────────────────
/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# ── Sitemap — 7 day cache ─────────────────────────────────────────────────────
/sitemap*.xml
  Cache-Control: public, max-age=604800, s-maxage=604800, stale-while-revalidate=86400
  Content-Type: application/xml

/sitemap_index.xml
  Cache-Control: public, max-age=604800, s-maxage=604800, stale-while-revalidate=86400
  Content-Type: application/xml

# ── Robots.txt — 24h cache ────────────────────────────────────────────────────
/robots.txt
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=3600

# ── RSS Feed ──────────────────────────────────────────────────────────────────
/feed.xml
  Cache-Control: public, max-age=86400, s-maxage=86400, stale-while-revalidate=3600
  Content-Type: application/rss+xml; charset=utf-8

# ── Noindex stub state paths ─────────────────────────────────────────────────
/delhi-ncr/*
  X-Robots-Tag: noindex, nofollow

/uttarakhand/*
  X-Robots-Tag: noindex, nofollow

/madhya-pradesh/*
  X-Robots-Tag: noindex, nofollow
